{
  "name": "langbank",
  "version": "2.0.0",
  "description": "Simple multilingual dictionary library for Node.js, browsers and PHP, driven by a CSV word list with simple placeholders.",
  "main": "libs/LangBank.js",
  "types": "libs/LangBank.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./libs/LangBank.d.mts",
        "default": "./libs/LangBank.mjs"
      },
      "require": {
        "types": "./libs/LangBank.d.ts",
        "default": "./libs/LangBank.js"
      }
    },
    "./package.json": "./package.json",
    "./libs/LangBank.js": "./libs/LangBank.js"
  },
  "browser": {
    "./libs/readTextFile.js": "./libs/readTextFile.browser.js"
  },
  "files": [
    "libs/"
  ],
  "engines": {
    "node": ">=14"
  },
  "scripts": {
    "test": "mocha ./tests/",
    "test:browser": "mocha ./tests/browser/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomk79/node-langbank.git"
  },
  "keywords": [
    "i18n"
  ],
  "author": "Tomoya Koyanagi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tomk79/node-langbank/issues"
  },
  "homepage": "https://github.com/tomk79/node-langbank#readme",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "mocha": "^10.8.2",
    "playwright": "^1.63.0"
  }
}
