	{"name": "_ENV.get() の中のバインド値は 1 回だけエスケープ", "source": "escape.csv", "options": {"autoescape": "html"}, "lang": "en", "key": "nested", "bind": {"name": "<b>&"}, "expected": "[Hi &lt;b&gt;&amp;]"},
	{"name": "_ENV.get() を二重にエスケープしない (js)", "source": "escape.csv", "options": {"autoescape": "js"}, "lang": "en", "key": "nested", "bind": {"name": "<b>&"}, "expected": "[Hi \\u003Cb\\u003E\\u0026]"},
	{"name": "_ENV.get() を二重にエスケープしない (css)", "source": "escape.csv", "options": {"autoescape": "css"}, "lang": "en", "key": "nested", "bind": {"name": "<b>&"}, "expected": "[Hi \\3C b\\3E \\26 ]"},
	{"name": "_ENV.get() を二重にエスケープしない (url)", "source": "escape.csv", "options": {"autoescape": "url"}, "lang": "en", "key": "nested", "bind": {"name": "<b>&"}, "expected": "[Hi %3Cb%3E%26]"},
	{"name": "_ENV.get() を二重にエスケープしない (html_attr)", "source": "escape.csv", "options": {"autoescape": "html_attr"}, "lang": "en", "key": "nested", "bind": {"name": "<b>&"}, "expected": "[Hi &lt;b&gt;&amp;]"},
	{"name": "_ENV.get() が返した未定義のキーはエスケープする", "source": "escape.csv", "options": {"autoescape": "html"}, "lang": "en", "key": "dynamic", "bind": {"name": "<b>&"}, "expected": "[&lt;b&gt;&amp;]"},
