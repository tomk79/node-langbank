[
	{"name": "基本: en", "source": "list.csv", "lang": "en", "key": "hello", "expected": "Hello"},
	{"name": "基本: ja", "source": "list.csv", "lang": "ja", "key": "hello", "expected": "こんにちわ"},
	{"name": "基本: anylang", "source": "list.csv", "lang": "anylang", "key": "goodmorning", "expected": "good morning in anylang"},
	{"name": "空セルはデフォルト言語にフォールバック", "source": "list.csv", "lang": "ja", "key": "no-ja1", "expected": "NoJa1"},
	{"name": "列が欠けたセルもデフォルト言語にフォールバック", "source": "list.csv", "lang": "ja", "key": "no-ja2", "expected": "NoJa2"},
	{"name": "全言語が空のキーはキーを返す", "source": "list.csv", "lang": "en", "key": "no-en1", "expected": "no-en1"},
	{"name": "未定義キーはキーを返す", "source": "list.csv", "lang": "ja", "key": "undefinedKey", "expected": "undefinedKey"},
	{"name": "未定義キーでデフォルト値を返す", "source": "list.csv", "lang": "en", "key": "undefinedKey", "default": "default value", "expected": "default value"},
	{"name": "未定義キーで空文字のデフォルト値を返す", "source": "list.csv", "lang": "en", "key": "undefinedKey", "default": "", "expected": ""},
	{"name": "第 2 引数の文字列と第 3 引数の null はデフォルト値", "source": "list.csv", "lang": "en", "key": "undefinedKey", "args": ["default value", null], "expected": "default value"},
	{"name": "第 2 引数のバインドと第 3 引数の null", "source": "list.csv", "lang": "en", "key": "bind1", "args": [{"test1": "local"}, null], "expected": "test local"},
	{"name": "第 2 引数の数値は無視する", "source": "list.csv", "options": {"bind": {"test1": "global"}}, "lang": "en", "key": "bind1", "args": [123], "expected": "test global"},
	{"name": "第 2 引数の真偽値は無視する", "source": "list.csv", "options": {"bind": {"test1": "global"}}, "lang": "en", "key": "undefinedKey", "args": [true, "D {{ test1 }}"], "expected": "D global"},
	{"name": "第 3 引数があれば第 2 引数の文字列は無視する", "source": "list.csv", "lang": "en", "key": "undefinedKey", "args": ["ignored", "D"], "expected": "D"},
	{"name": "定義済みキーではデフォルト値を使わない", "source": "list.csv", "lang": "en", "key": "hello", "default": "default value", "expected": "Hello"},
	{"name": "options.bind", "source": "list.csv", "options": {"bind": {"test1": "bind test 1"}}, "lang": "en", "key": "bind1", "expected": "test bind test 1"},
	{"name": "get() のバインドが options.bind より優先", "source": "list.csv", "options": {"bind": {"test1": "bind test 1"}}, "lang": "en", "key": "bind1", "bind": {"test1": "local"}, "expected": "test local"},
	{"name": "バインドとデフォルト値", "source": "list.csv", "lang": "en", "key": "bind1", "bind": {"test1": "local 2"}, "default": "tpl: {{ test1 }}", "expected": "test local 2"},
	{"name": "デフォルト値のプレースホルダーも置き換える", "source": "list.csv", "lang": "en", "key": "undefined", "bind": {"test1": "local 3"}, "default": "tpl: {{ test1 }}", "expected": "tpl: local 3"},
	{"name": "バインドに null を渡せる", "source": "list.csv", "lang": "en", "key": "undefined", "bind": null, "default": "fallback", "expected": "fallback"},
	{"name": "未定義の変数は空文字", "source": "list.csv", "lang": "en", "key": "bind1", "bind": null, "default": "x", "expected": "test "},
	{"name": "マージ: 後の CSV で空セルを埋める", "source": ["merge_a.csv", "merge_b.csv"], "lang": "ja_jp", "key": "hello", "expected": "こんにちは"},
	{"name": "マージ: 前の CSV の値を残す", "source": ["merge_a.csv", "merge_b.csv"], "lang": "en", "key": "hello", "expected": "Hello"},
	{"name": "マージ: 新しい言語の列", "source": ["merge_a.csv", "merge_b.csv"], "lang": "fr", "key": "hello", "expected": "Bonjour"},
	{"name": "マージ: 空セルでは上書きしない", "source": ["merge_a.csv", "merge_b.csv"], "lang": "ja", "key": "bye", "expected": "さようなら"},
	{"name": "マージ: 後の CSV だけにあるキー", "source": ["merge_a.csv", "merge_b.csv"], "lang": "ja", "key": "onlyb", "expected": "Bだけ"},
	{"name": "マージ: デフォルト言語は最初の CSV", "source": ["merge_a.csv", "merge_b.csv"], "lang": "fr", "key": "bye", "expected": "Bye"},
	{"name": "マージ: 同じファイル内の重複キー (en)", "source": "merge_a.csv", "lang": "en", "key": "dup", "expected": "first"},
	{"name": "マージ: 同じファイル内の重複キー (ja)", "source": "merge_a.csv", "lang": "ja", "key": "dup", "expected": "重複2"},
	{"name": "列数が揃わない CSV: 短い行", "source": "ragged.csv", "lang": "ja", "key": "short", "expected": "Short"},
	{"name": "列数が揃わない CSV: 長い行", "source": "ragged.csv", "lang": "ja", "key": "long", "expected": "長い"},
	{"name": "フォールバック: 完全一致", "source": "regional.csv", "lang": "en-US", "key": "color", "expected": "Color"},
	{"name": "フォールバック: 空セルなら親の言語", "source": "regional.csv", "lang": "en-US", "key": "hello", "expected": "Hello"},
	{"name": "フォールバック: _ と大小文字", "source": "regional.csv", "lang": "EN_us", "key": "color", "expected": "Color"},
	{"name": "フォールバック: 地域コードを削る", "source": "regional.csv", "lang": "en-GB", "key": "color", "expected": "Colour"},
	{"name": "フォールバック: ja_JP", "source": "regional.csv", "lang": "ja_JP", "key": "hello", "expected": "こんにちは"},
	{"name": "フォールバック: 3 段", "source": "regional.csv", "lang": "zh-Hant-TW", "key": "hello", "expected": "你好"},
	{"name": "フォールバック: 該当なしはデフォルト言語", "source": "regional.csv", "lang": "zh-HK", "key": "hello", "expected": "Hello"},
	{"name": "フォールバック: options.fallback", "source": "regional.csv", "options": {"fallback": {"zh-HK": ["zh-Hant"]}}, "lang": "zh-HK", "key": "hello", "expected": "你好"},
	{"name": "フォールバック: options.fallback のキーも正規化", "source": "regional.csv", "options": {"fallback": {"zh_hk": ["zh-Hant"]}}, "lang": "zh-HK", "key": "hello", "expected": "你好"},
	{"name": "フォールバック: options.fallback は自動より優先", "source": "regional.csv", "options": {"fallback": {"en-AU": ["en-US"]}}, "lang": "en-AU", "key": "color", "expected": "Color"},
	{"name": "フォールバック: pt-BR", "source": "regional.csv", "lang": "pt-BR", "key": "hello", "expected": "Olá"},
	{"name": "フォールバック: options.fallback の言語はサブタグを削らない", "source": "regional.csv", "options": {"fallback": {"zh-HK": ["zh-Hant-TW"]}}, "lang": "zh-HK", "key": "hello", "expected": "Hello"},
	{"name": "言語名の揺れ: 同じファイル内の列をまとめる", "source": "header_case_a.csv", "lang": "en", "key": "bye", "expected": "Bye"},
	{"name": "言語名の揺れ: 同じファイル内の列をまとめる (EN)", "source": "header_case_a.csv", "lang": "EN", "key": "hello", "expected": "Hello"},
	{"name": "言語名の揺れ: 後の CSV の列をまとめる", "source": ["header_case_a.csv", "header_case_b.csv"], "lang": "ja-JP", "key": "bye", "expected": "さようなら"},
	{"name": "言語名の揺れ: 前の CSV の値を残す", "source": ["header_case_a.csv", "header_case_b.csv"], "lang": "ja_jp", "key": "hello", "expected": "こんにちは"},
	{"name": "プレースホルダー: 基本", "source": "placeholders.csv", "lang": "en", "key": "greet", "bind": {"name": "Tom"}, "expected": "Hi Tom"},
	{"name": "プレースホルダー: 空白なし", "source": "placeholders.csv", "lang": "en", "key": "greet_nospace", "bind": {"name": "Tom"}, "expected": "Hi Tom"},
	{"name": "プレースホルダー: タブと改行", "source": "placeholders.csv", "lang": "en", "key": "greet_ws", "bind": {"name": "Tom"}, "expected": "Hi Tom"},
	{"name": "プレースホルダー: 同じ変数を何度でも使える", "source": "placeholders.csv", "lang": "en", "key": "twice", "bind": {"a": "A", "b": "B"}, "expected": "A-B-A"},
	{"name": "プレースホルダー: 変数名の _ と数字と大文字", "source": "placeholders.csv", "lang": "en", "key": "names", "bind": {"_a1": "x", "A_b": "y"}, "expected": "[x][y]"},
	{"name": "プレースホルダー: 対応しない }} と { は文字のまま", "source": "placeholders.csv", "lang": "en", "key": "braces", "bind": {"name": "Tom"}, "expected": "{ Tom }} {a}"},
	{"name": "プレースホルダー: 既定ではエスケープしない", "source": "placeholders.csv", "lang": "en", "key": "html", "bind": {"name": "<i>&"}, "expected": "Hello, <b><i>&</b>"},
	{"name": "プレースホルダー: 差し込んだ値は置き換えない", "source": "placeholders.csv", "lang": "en", "key": "greet", "bind": {"name": "{{ name }}"}, "expected": "Hi {{ name }}"},
	{"name": "プレースホルダー: 差し込んだ値の予約した構文はエラーにしない", "source": "placeholders.csv", "lang": "en", "key": "greet", "bind": {"name": "{% if %}{# x #}{{"}, "expected": "Hi {% if %}{# x #}{{"},
	{"name": "プレースホルダー: 値の型", "source": "placeholders.csv", "lang": "en", "key": "types", "bind": {"s": "S", "i": -12, "x": 1.5, "t": true, "f": false, "n": null}, "expected": "[S][-12][1.5][1][][][]"},
	{"name": "プレースホルダー: 配列の値は TEMPLATE_ERROR", "source": "placeholders.csv", "lang": "en", "key": "greet", "bind": {"name": ["a"]}, "error": "TEMPLATE_ERROR", "message": "\"name\""},
	{"name": "プレースホルダー: オブジェクトの値は TEMPLATE_ERROR", "source": "placeholders.csv", "lang": "en", "key": "greet", "bind": {"name": {"a": 1}}, "error": "TEMPLATE_ERROR", "message": "key \"greet\""},
	{"name": "プレースホルダー: 使わない変数の型は調べない", "source": "placeholders.csv", "lang": "en", "key": "greet", "bind": {"name": "Tom", "other": ["a"]}, "expected": "Hi Tom"},
	{"name": "プレースホルダー: ほかの言語の列", "source": "placeholders.csv", "lang": "ja", "key": "ja_only", "bind": {"name": "太郎"}, "expected": "日本語 太郎"},
	{"name": "プレースホルダー: キーの列は調べない", "source": "placeholders.csv", "lang": "en", "key": "{% key %}", "expected": "Keys are not checked"},
	{"name": "プレースホルダー: options.bind", "source": "placeholders.csv", "options": {"bind": {"name": "Global"}}, "lang": "en", "key": "greet", "expected": "Hi Global"},
	{"name": "プレースホルダー: get() のバインドが優先", "source": "placeholders.csv", "options": {"bind": {"name": "Global"}}, "lang": "en", "key": "greet", "bind": {"name": "Local"}, "expected": "Hi Local"},
	{"name": "プレースホルダー: get() で null を渡すと空文字", "source": "placeholders.csv", "options": {"bind": {"name": "Global"}}, "lang": "en", "key": "greet", "bind": {"name": null}, "expected": "Hi "},
	{"name": "プレースホルダー: template: false", "source": "placeholders.csv", "options": {"template": false}, "lang": "en", "key": "greet", "bind": {"name": "Tom"}, "expected": "Hi {{ name }}"},
	{"name": "プレースホルダー: template: false ならデフォルト値も置き換えない", "source": "placeholders.csv", "options": {"template": false}, "lang": "en", "key": "nokey", "bind": {"name": "Tom"}, "default": "D {{ name }} {%", "expected": "D {{ name }} {%"},
	{"name": "プレースホルダー: 未定義のキーはそのまま返す", "source": "placeholders.csv", "lang": "en", "key": "{{ name }}", "bind": {"name": "Tom"}, "expected": "{{ name }}"},
	{"name": "予約した構文: デフォルト値は get() でエラー", "source": "placeholders.csv", "lang": "en", "key": "nokey", "default": "{% if x %}", "error": "TEMPLATE_ERROR", "message": "the default value of key \"nokey\""},
	{"name": "予約した構文: デフォルト値の閉じていない {{", "source": "placeholders.csv", "lang": "en", "key": "nokey", "default": "Hello, {{ name", "error": "TEMPLATE_ERROR"},
	{"name": "予約した構文: 読み込み時にエラー: {% if x %}a{% endif %}", "rows": [["", "en"], ["ok", "OK"], ["k", "{% if x %}a{% endif %}"]], "lang": "en", "key": "ok", "error": "TEMPLATE_ERROR", "message": "the word of key \"k\" (lang: en)"},
	{"name": "予約した構文: 読み込み時にエラー: {# comment #}", "rows": [["", "en"], ["ok", "OK"], ["k", "{# comment #}"]], "lang": "en", "key": "ok", "error": "TEMPLATE_ERROR", "message": "the word of key \"k\" (lang: en)"},
	{"name": "予約した構文: 読み込み時にエラー: {{ user.name }}", "rows": [["", "en"], ["ok", "OK"], ["k", "{{ user.name }}"]], "lang": "en", "key": "ok", "error": "TEMPLATE_ERROR", "message": "the word of key \"k\" (lang: en)"},
	{"name": "予約した構文: 読み込み時にエラー: {{ name|upper }}", "rows": [["", "en"], ["ok", "OK"], ["k", "{{ name|upper }}"]], "lang": "en", "key": "ok", "error": "TEMPLATE_ERROR", "message": "the word of key \"k\" (lang: en)"},
	{"name": "予約した構文: 読み込み時にエラー: Hello, {{ name", "rows": [["", "en"], ["ok", "OK"], ["k", "Hello, {{ name"]], "lang": "en", "key": "ok", "error": "TEMPLATE_ERROR", "message": "the word of key \"k\" (lang: en)"},
	{"name": "予約した構文: 読み込み時にエラー: {{- name }}", "rows": [["", "en"], ["ok", "OK"], ["k", "{{- name }}"]], "lang": "en", "key": "ok", "error": "TEMPLATE_ERROR", "message": "the word of key \"k\" (lang: en)"},
	{"name": "予約した構文: 読み込み時にエラー: {{ name -}}", "rows": [["", "en"], ["ok", "OK"], ["k", "{{ name -}}"]], "lang": "en", "key": "ok", "error": "TEMPLATE_ERROR", "message": "the word of key \"k\" (lang: en)"},
	{"name": "予約した構文: 読み込み時にエラー: {{{ name }}}", "rows": [["", "en"], ["ok", "OK"], ["k", "{{{ name }}}"]], "lang": "en", "key": "ok", "error": "TEMPLATE_ERROR", "message": "the word of key \"k\" (lang: en)"},
	{"name": "予約した構文: 読み込み時にエラー: {{ 1name }}", "rows": [["", "en"], ["ok", "OK"], ["k", "{{ 1name }}"]], "lang": "en", "key": "ok", "error": "TEMPLATE_ERROR", "message": "the word of key \"k\" (lang: en)"},
	{"name": "予約した構文: 読み込み時にエラー: {{ }}", "rows": [["", "en"], ["ok", "OK"], ["k", "{{ }}"]], "lang": "en", "key": "ok", "error": "TEMPLATE_ERROR", "message": "the word of key \"k\" (lang: en)"},
	{"name": "予約した構文: 読み込み時にエラー: {{ 名前 }}", "rows": [["", "en"], ["ok", "OK"], ["k", "{{ 名前 }}"]], "lang": "en", "key": "ok", "error": "TEMPLATE_ERROR", "message": "the word of key \"k\" (lang: en)"},
	{"name": "予約した構文: 読み込み時にエラー: {{(全角空白)name }}", "rows": [["", "en"], ["ok", "OK"], ["k", "{{　name }}"]], "lang": "en", "key": "ok", "error": "TEMPLATE_ERROR", "message": "the word of key \"k\" (lang: en)"},
	{"name": "予約した構文: 読み込み時にエラー: {{ _ENV.get('x') }}", "rows": [["", "en"], ["ok", "OK"], ["k", "{{ _ENV.get('x') }}"]], "lang": "en", "key": "ok", "error": "TEMPLATE_ERROR", "message": "the word of key \"k\" (lang: en)"},
	{"name": "予約した構文: 読み込み時にエラー: {{ 'text' }}", "rows": [["", "en"], ["ok", "OK"], ["k", "{{ 'text' }}"]], "lang": "en", "key": "ok", "error": "TEMPLATE_ERROR", "message": "the word of key \"k\" (lang: en)"},
	{"name": "予約した構文: 読み込み時のエラーにはその構文を含める", "rows": [["", "en"], ["k", "a {% if x %}b"]], "lang": "en", "key": "k", "error": "TEMPLATE_ERROR", "message": "\"{% if x %}b\""},
	{"name": "予約した構文: ほかの言語の列も調べる", "rows": [["", "en", "ja"], ["k", "OK", "{% x %}"]], "lang": "en", "key": "k", "error": "TEMPLATE_ERROR", "message": "(lang: ja)"},
	{"name": "予約した構文: キーが空の行は調べない", "rows": [["", "en"], ["", "{% x %}"], ["k", "OK"]], "lang": "en", "key": "k", "expected": "OK"},
	{"name": "予約した構文: 言語の列でない列は調べない", "rows": [["", "en", ""], ["k", "OK", "{% x %}"]], "lang": "en", "key": "k", "expected": "OK"},
	{"name": "予約した構文: template: false なら読み込み時に調べない", "rows": [["", "en"], ["k", "{% raw %}{{ x.y }}"]], "options": {"template": false}, "lang": "en", "key": "k", "expected": "{% raw %}{{ x.y }}"},
	{"name": "予約した構文: }} だけと { だけは文字", "rows": [["", "en"], ["k", "a }} b { c {a} {"]], "lang": "en", "key": "k", "expected": "a }} b { c {a} {"}
