[
	{"name": "基本: en", "source": "list_twig.csv", "lang": "en", "key": "hello", "expected": "Hello"},
	{"name": "基本: ja", "source": "list_twig.csv", "lang": "ja", "key": "hello", "expected": "こんにちわ"},
	{"name": "基本: anylang", "source": "list_twig.csv", "lang": "anylang", "key": "goodmorning", "expected": "good morning in anylang"},
	{"name": "空セルはデフォルト言語にフォールバック", "source": "list_twig.csv", "lang": "ja", "key": "no-ja1", "expected": "NoJa1"},
	{"name": "列が欠けたセルもデフォルト言語にフォールバック", "source": "list_twig.csv", "lang": "ja", "key": "no-ja2", "expected": "NoJa2"},
	{"name": "全言語が空のキーはキーを返す", "source": "list_twig.csv", "lang": "en", "key": "no-en1", "expected": "no-en1"},
	{"name": "未定義キーはキーを返す", "source": "list_twig.csv", "lang": "ja", "key": "undefinedKey", "expected": "undefinedKey"},
	{"name": "未定義キーでデフォルト値を返す", "source": "list_twig.csv", "lang": "en", "key": "undefinedKey", "default": "default value", "expected": "default value"},
	{"name": "未定義キーで空文字のデフォルト値を返す", "source": "list_twig.csv", "lang": "en", "key": "undefinedKey", "default": "", "expected": ""},
	{"name": "定義済みキーではデフォルト値を使わない", "source": "list_twig.csv", "lang": "en", "key": "hello", "default": "default value", "expected": "Hello"},

	{"name": "_ENV.lang", "source": "list_twig.csv", "lang": "ja", "key": "bind2", "expected": "ja"},
	{"name": "_ENV.defaultLang", "source": "list_twig.csv", "lang": "ja", "key": "bind3", "expected": "en"},
	{"name": "_ENV.get()", "source": "list_twig.csv", "lang": "ja", "key": "bind4", "expected": "こんにちわ"},
	{"name": "options.bind", "source": "list_twig.csv", "options": {"bind": {"test1": "bind test 1"}}, "lang": "en", "key": "bind1", "expected": "test bind test 1"},
	{"name": "get() のバインドが options.bind より優先", "source": "list_twig.csv", "options": {"bind": {"test1": "bind test 1"}}, "lang": "en", "key": "bind1", "bind": {"test1": "local"}, "expected": "test local"},
	{"name": "バインドとデフォルト値", "source": "list_twig.csv", "lang": "en", "key": "bind1", "bind": {"test1": "local 2"}, "default": "tpl: {{ test1 }}", "expected": "test local 2"},
	{"name": "デフォルト値も Twig で評価する", "source": "list_twig.csv", "lang": "en", "key": "undefined", "bind": {"test1": "local 3"}, "default": "tpl: {{ test1 }}", "expected": "tpl: local 3"},
	{"name": "バインドに null を渡せる", "source": "list_twig.csv", "lang": "en", "key": "undefined", "bind": null, "default": "fallback", "expected": "fallback"},
	{"name": "未定義の変数は空文字", "source": "list_twig.csv", "lang": "en", "key": "bind1", "bind": null, "default": "x", "expected": "test "},

	{"name": "既定ではエスケープしない", "source": "escape.csv", "lang": "en", "key": "greet", "bind": {"name": "<b>&"}, "expected": "Hi <b>&"},
	{"name": "autoescape: html", "source": "escape.csv", "options": {"autoescape": "html"}, "lang": "en", "key": "greet", "bind": {"name": "<b>&"}, "expected": "Hi &lt;b&gt;&amp;"},
	{"name": "_ENV.get() の結果をエスケープしない", "source": "escape.csv", "lang": "en", "key": "ref", "expected": "Tom & Jerry"},
	{"name": "_ENV.get() の結果を autoescape でエスケープ", "source": "escape.csv", "options": {"autoescape": "html"}, "lang": "en", "key": "ref", "expected": "Tom &amp; Jerry"},
	{"name": "Twig の記法を含まない訳文はそのまま", "source": "escape.csv", "options": {"autoescape": "html"}, "lang": "en", "key": "amp", "expected": "Tom & Jerry"},
	{"name": "{% raw %}", "source": "escape.csv", "lang": "en", "key": "raw", "expected": "{{ literal }}"},
	{"name": "twig: false", "source": "escape.csv", "options": {"twig": false}, "lang": "en", "key": "greet", "bind": {"name": "A"}, "expected": "Hi {{ name }}"},
	{"name": "twig: false なら構文エラーにならない", "source": "escape.csv", "options": {"twig": false}, "lang": "en", "key": "bad", "expected": "{{ broken"},

	{"name": "マージ: 後の CSV で空セルを埋める", "source": ["merge_a.csv", "merge_b.csv"], "lang": "ja", "key": "hello", "expected": "こんにちは"},
	{"name": "マージ: 前の CSV の値を残す", "source": ["merge_a.csv", "merge_b.csv"], "lang": "en", "key": "hello", "expected": "Hello"},
	{"name": "マージ: 新しい言語の列", "source": ["merge_a.csv", "merge_b.csv"], "lang": "fr", "key": "hello", "expected": "Bonjour"},
	{"name": "マージ: 空セルでは上書きしない", "source": ["merge_a.csv", "merge_b.csv"], "lang": "ja", "key": "bye", "expected": "さようなら"},
	{"name": "マージ: 後の CSV だけにあるキー", "source": ["merge_a.csv", "merge_b.csv"], "lang": "ja", "key": "onlyb", "expected": "Bだけ"},
	{"name": "マージ: デフォルト言語は最初の CSV", "source": ["merge_a.csv", "merge_b.csv"], "lang": "fr", "key": "bye", "expected": "Bye"},
	{"name": "マージ: 同じファイル内の重複キー (en)", "source": "merge_a.csv", "lang": "en", "key": "dup", "expected": "first"},
	{"name": "マージ: 同じファイル内の重複キー (ja)", "source": "merge_a.csv", "lang": "ja", "key": "dup", "expected": "重複2"},

	{"name": "列数が揃わない CSV: 短い行", "source": "ragged.csv", "lang": "ja", "key": "short", "expected": "Short"},
	{"name": "列数が揃わない CSV: 長い行", "source": "ragged.csv", "lang": "ja", "key": "long", "expected": "長い"},

	{"name": "フォールバック: 完全一致", "source": "regional.csv", "lang": "en-US", "key": "color", "expected": "Color"},
	{"name": "フォールバック: 空セルなら親の言語", "source": "regional.csv", "lang": "en-US", "key": "hello", "expected": "Hello"},
	{"name": "フォールバック: _ と大小文字", "source": "regional.csv", "lang": "EN_us", "key": "color", "expected": "Color"},
	{"name": "フォールバック: 地域コードを削る", "source": "regional.csv", "lang": "en-GB", "key": "color", "expected": "Colour"},
	{"name": "フォールバック: ja_JP", "source": "regional.csv", "lang": "ja_JP", "key": "hello", "expected": "こんにちは"},
	{"name": "フォールバック: 3 段", "source": "regional.csv", "lang": "zh-Hant-TW", "key": "hello", "expected": "你好"},
	{"name": "フォールバック: 該当なしはデフォルト言語", "source": "regional.csv", "lang": "zh-HK", "key": "hello", "expected": "Hello"},
	{"name": "フォールバック: options.fallback", "source": "regional.csv", "options": {"fallback": {"zh-HK": ["zh-Hant"]}}, "lang": "zh-HK", "key": "hello", "expected": "你好"},
	{"name": "フォールバック: options.fallback のキーも正規化", "source": "regional.csv", "options": {"fallback": {"zh_hk": ["zh-Hant"]}}, "lang": "zh-HK", "key": "hello", "expected": "你好"},
	{"name": "フォールバック: options.fallback は自動より優先", "source": "regional.csv", "options": {"fallback": {"en-AU": ["en-US"]}}, "lang": "en-AU", "key": "color", "expected": "Color"},
	{"name": "フォールバック: pt-BR", "source": "regional.csv", "lang": "pt-BR", "key": "hello", "expected": "Olá"}
]
