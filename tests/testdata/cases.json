	{"name": "_ENV.defaultLang", "source": "list_twig.csv", "lang": "ja", "key": "bind3", "expected": "en"},
	{"name": "_ENV.get()", "source": "list_twig.csv", "lang": "ja", "key": "bind4", "expected": "こんにちわ"},
